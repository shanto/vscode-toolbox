{
  "name": "vscode-toolbox",
  "version": "1.1.6",
  "scripts": {
    "cli": "node src/cli.ts",
    "prebuild": "rm -r dist || mkdir dist",
    "build": "npm i && tsc",
    "prepublishOnly": "npm run build"
  },
  "type": "module",
  "homepage": "https://github.com/shanto/vscode-toolbox",
  "author": {
    "name": "Shaan",
    "email": "mail@shaan.icu",
    "url": "https://github.com/shanto"
  },
  "license": "MIT",
  "description": "Mange profiles and extensions under VS Code and other IDE products built from it.",
  "dependencies": {
    "commander": "^14.0.2",
    "js-yaml": "^4.1.0",
    "prompts": "^2.4.2",
    "title-case": "^4.3.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.10.0",
    "@types/prompts": "^2.4.9"
